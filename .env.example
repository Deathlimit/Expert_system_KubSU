# Локальный запуск backend_render.
# Скопируйте в .env и заполните под себя (файл .env в git не попадёт).

# MongoDB. На Render обязателен Atlas: диск не сохраняется.
MONGO_URI=mongodb://admin:admin123@localhost:27017/testing_expert?authSource=admin

# Секрет подписи JWT. На Render генерируется автоматически.
JWT_SECRET=testing-expert-system-jwt-secret-2026

# origins через запятую или * для локальной разработки.
CORS_ORIGINS=*

# Токен домашнего воркера. Пусто — воркер пускается без токена (только dev).
WORKER_TOKEN=

# Keep-alive: раз в N секунд бэкенд дёргает свой /health, чтобы бесплатный
# Render не засыпал после 15 минут без трафика. Адрес берётся из
# RENDER_EXTERNAL_URL (его подставляет сам Render) или KEEPALIVE_URL.
# Локально KEEPALIVE_URL пуст — keep-alive выключается.
KEEPALIVE_ENABLED=true
KEEPALIVE_INTERVAL_SECONDS=60
KEEPALIVE_URL=

# Очередь.
QUEUE_LEASE_SECONDS=600
QUEUE_TASK_TTL_SECONDS=0

# Контракт с домашней LLM (сама модель здесь не запускается).
OLLAMA_MODEL=gemma4:12b
LLM_THINK=false
LLM_MAX_ERRORS=30
LLM_NUM_CTX=8192
LLM_NUM_PREDICT=4096
